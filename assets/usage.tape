Output assets/usage.gif
Set CursorBlink false
Set FontSize 16
Set Framerate 20
Set Height 600
Set Margin 0
Set PlaybackSpeed 1.0
Set Shell zsh
Set Theme "iTerm2 Default"
Set TypingSpeed 60ms
Set Width 1200

Type "webcomp -p dummy -b -c -d -g -z --dry-run"
Sleep 1s
Enter
Sleep 200ms
Screenshot assets/usage.banner.png
Sleep 4s
